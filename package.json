{
  "name": "aurora-files",
  "private": true,
  "version": "0.1.5",
  "description": "Aurora Files — Apple-style file manager for Windows (Electron + real disk)",
  "author": "skylinezhanghan-wq",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "build:web": "vite build",
    "build:electron-renderer": "cross-env AURORA_ELECTRON=1 vite build",
    "build:desktop": "npm run icons:gen && cross-env AURORA_ELECTRON=1 vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --publish never",
    "build:desktop:dir": "npm run icons:gen && cross-env AURORA_ELECTRON=1 vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --dir --publish never",
    "build:desktop:signed": "npm run icons:gen && cross-env AURORA_ELECTRON=1 vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=true electron-builder --win --x64 --publish never",
    "build:desktop:publish": "npm run icons:gen && cross-env AURORA_ELECTRON=1 vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=true electron-builder --win --x64 --publish always",
    "icons:gen": "node scripts/gen-icon.mjs",
    "ffmpeg:ensure": "node scripts/ensure-ffmpeg.mjs",
    "postinstall": "node scripts/ensure-ffmpeg.mjs",
    "ci": "npm run typecheck && npm test -- --run && npm run test:e2e && npm run test:real-search && npm run test:smoke-win",
    "preview": "vite preview",
    "desktop": "npm run dev:desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:index": "playwright test e2e/index-status.spec.ts",
    "test:e2e:features": "playwright test e2e/features-coverage.spec.ts e2e/context-menu.spec.ts e2e/demo-ux.spec.ts",
    "test:e2e:full-gui": "cross-env AURORA_PERF_RUN_ID=gui-full-latest playwright test e2e/full-gui.spec.ts",
    "test:e2e:all-visual": "cross-env AURORA_ELECTRON= AURORA_PERF_RUN_ID=gui-full-latest playwright test e2e/full-gui.spec.ts e2e/ui-visual-check.spec.ts e2e/index-status.spec.ts e2e/demo-ux.spec.ts e2e/preview-media.spec.ts e2e/context-menu.spec.ts e2e/features-coverage.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke-win": "node scripts/win-unpacked-smoke.mjs",
    "test:real-search": "node scripts/real-search-e2e.mjs --assert",
    "test:index-bench": "node scripts/index-bench.mjs",
    "test:index-bench:json": "node scripts/index-bench.mjs --json release/index-bench.json",
    "test:perf-backend": "node scripts/perf/measure-backend.mjs",
    "test:perf-ui": "playwright test e2e/perf-baseline.spec.ts",
    "test:perf-ui-visual": "playwright test e2e/ui-visual-check.spec.ts",
    "test:perf-baseline": "node scripts/perf/run-baseline.mjs",
    "test:perf-real": "node scripts/perf/measure-real-disk.mjs",
    "test:perf-volume": "node scripts/perf/measure-volume.mjs",
    "test:perf-diff": "node scripts/perf/measure-diff.mjs",
    "test:perf-bakeoff": "node scripts/perf/run-bakeoff.mjs",
    "test:perf-bakeoff:elevated": "node scripts/perf/bakeoff-elevated.mjs",
    "test:perf-hydrate": "node scripts/perf/measure-hydrate.mjs",
    "test:perf-indexd": "cargo build --release --manifest-path native/indexd/Cargo.toml && node --expose-gc scripts/perf/measure-indexd.mjs",
    "test:perf-startup": "node scripts/perf/measure-startup.mjs",
    "native:walk-bench": "cargo build --release --manifest-path native/walk-bench/Cargo.toml",
    "native:indexd": "cargo build --release --manifest-path native/indexd/Cargo.toml",
    "native:mft-enum": "cmake -S native/mft-enum -B native/mft-enum/build -G \"Visual Studio 18 2026\" -A x64 && cmake --build native/mft-enum/build --config Release",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.2.0",
    "framer-motion": "^14.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.aurora.files",
    "productName": "Aurora Files",
    "executableName": "AuroraFiles",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "!electron/**/*.test.ts",
      "!shared/**/*.test.ts",
      "!node_modules/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*"
    ],
    "asarUnpack": [
      "electron/index/usn-read.ps1"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "native/indexd/target/release/aurora-indexd.exe",
        "to": "native/aurora-indexd.exe"
      },
      {
        "from": "native/walk-bench/target/release/aurora-walk-bench.exe",
        "to": "native/aurora-walk-bench.exe"
      },
      {
        "from": "native/mft-enum/build/Release/aurora-mft-enum.exe",
        "to": "native/aurora-mft-enum.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Aurora Files",
      "uninstallDisplayName": "Aurora Files",
      "artifactName": "AuroraFiles-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AuroraFiles-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "skylinezhanghan-wq",
        "repo": "AuroraFiles",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.4"
  }
}
